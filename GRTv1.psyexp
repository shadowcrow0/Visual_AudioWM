      <CodeComponent name="pattern" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="print(f&quot;win size: {win.size}, aspect: {win.size[0]/win.size[1]:.3f}&quot;)&amp;#10;print(f&quot;x edge in height units: ±{win.size[0]/win.size[1]/2:.3f}&quot;)&amp;#10;import numpy as np&amp;#10;rng = np.random.default_rng()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as np from 'numpy';&amp;#10;console.log(`win size: ${psychoJS.window.size}, aspect: ${util.pad(Number.parseFloat((psychoJS.window.size[0] / psychoJS.window.size[1])).toFixed(3), 1)}`);&amp;#10;console.log(`x edge in height units: ±${util.pad(Number.parseFloat(((psychoJS.window.size[0] / psychoJS.window.size[1]) / 2)).toFixed(3), 1)}`);&amp;#10;rng = np.random.default_rng();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="itemAudi = [&quot;stimuli/b3.wav&quot;, &quot;stimuli/b3.wav&quot;, &quot;stimuli/p3.wav&quot;, &quot;stimuli/p3.wav&quot;];&amp;#10;Fix_Dur = 0.3;&amp;#10;itemColhex = [&quot;#B744A1&quot;, &quot;#B52C95&quot;, &quot;#B744A1&quot;, &quot;#B52C95&quot;];&amp;#10;d = (10.0 / np.sqrt(2));&amp;#10;SIZE = [0.7, 0.8, 1.1, 1.3];&amp;#10;POS = [[d, d], [(- d), d], [(- d), (- d)], [d, (- d)]];&amp;#10;order = rng.permutation(4);&amp;#10;[posAx, posAy] = POS[order[0]];&amp;#10;[posBx, posBy] = POS[order[1]];&amp;#10;[posCx, posCy] = POS[order[2]];&amp;#10;[posDx, posDy] = POS[order[3]];&amp;#10;NAMES = [&quot;UR&quot;, &quot;UL&quot;, &quot;BL&quot;, &quot;BR&quot;];&amp;#10;quadA = NAMES[order[0]];&amp;#10;quadB = NAMES[order[1]];&amp;#10;quadC = NAMES[order[2]];&amp;#10;quadD = NAMES[order[3]];&amp;#10;START = [0.3, 1.3, 2.3, 3.3];&amp;#10;DUR = 1.0;&amp;#10;TimeStartA = START[order[0]];&amp;#10;TimeStartB = START[order[1]];&amp;#10;TimeStartC = START[order[2]];&amp;#10;TimeStartD = START[order[3]];&amp;#10;itemAudiA = itemAudi[order[0]];&amp;#10;itemAudiB = itemAudi[order[1]];&amp;#10;itemAudiC = itemAudi[order[2]];&amp;#10;itemAudiD = itemAudi[order[3]];&amp;#10;StudyA = itemColhex[order[0]];&amp;#10;StudyB = itemColhex[order[1]];&amp;#10;StudyC = itemColhex[order[2]];&amp;#10;StudyD = itemColhex[order[3]];&amp;#10;item_quad = [];&amp;#10;for (var k, _pj_c = 0, _pj_a = util.range(4), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    k = _pj_a[_pj_c];&amp;#10;    item_quad[order[k]] = NAMES[k];&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#ToDo&amp;#10;#define colorABCD&amp;#10;itemAudi = ['stimuli/b3.wav','stimuli/b3.wav', 'stimuli/p3.wav', 'stimuli/p3.wav']&amp;#10;&amp;#10;Fix_Dur = .3&amp;#10;itemColhex = ['#B744A1', &amp;#10;              '#B52C95',&amp;#10;              '#B744A1',&amp;#10;              '#B52C95']&amp;#10;&amp;#10;&amp;#10;d = 10.0 / np.sqrt(2)      # 偏心度 5 度&amp;#10;SIZE = [.7, .8, 1.1 ,1.3]&amp;#10;POS = [&amp;#10;    ( d,  d),    # 0 = 右上&amp;#10;    (-d,  d),    # 1 = 左上&amp;#10;    (-d, -d),    # 2 = 左下&amp;#10;    ( d, -d),    # 3 = 右下&amp;#10;]&amp;#10;order = rng.permutation(4)&amp;#10;&amp;#10;posAx, posAy = POS[order[0]]&amp;#10;posBx, posBy = POS[order[1]]&amp;#10;posCx, posCy = POS[order[2]]&amp;#10;posDx, posDy = POS[order[3]]&amp;#10;NAMES = ['UR', 'UL', 'BL', 'BR']&amp;#10;&amp;#10;quadA = NAMES[order[0]]&amp;#10;quadB = NAMES[order[1]]&amp;#10;quadC = NAMES[order[2]]&amp;#10;quadD = NAMES[order[3]]&amp;#10;&amp;#10;START = [0.3, 1.3, 2.3, 3.3]&amp;#10;DUR = 1.0&amp;#10;TimeStartA = START[order[0]]&amp;#10;TimeStartB = START[order[1]]&amp;#10;TimeStartC = START[order[2]]&amp;#10;TimeStartD = START[order[3]]&amp;#10;itemAudiA = itemAudi[order[0]]&amp;#10;itemAudiB = itemAudi[order[1]]&amp;#10;itemAudiC = itemAudi[order[2]]&amp;#10;itemAudiD = itemAudi[order[3]]&amp;#10;StudyA = itemColhex[order[0]]&amp;#10;StudyB = itemColhex[order[1]]&amp;#10;StudyC = itemColhex[order[2]]&amp;#10;StudyD = itemColhex[order[3]]&amp;#10;item_quad = [None, None, None, None]       # item index -&gt; 象限名稱(UR/UL/BL/BR)&amp;#10;for k in range(4):&amp;#10;    item_quad[order[k]] = NAMES[k]" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="NAMES = [&quot;UR&quot;, &quot;UL&quot;, &quot;BL&quot;, &quot;BR&quot;];&amp;#10;psychoJS.experiment.addData(&quot;quadA&quot;, quadA);&amp;#10;psychoJS.experiment.addData(&quot;quadB&quot;, quadB);&amp;#10;psychoJS.experiment.addData(&quot;quadC&quot;, quadC);&amp;#10;psychoJS.experiment.addData(&quot;quadD&quot;, quadD);&amp;#10;psychoJS.experiment.addData(&quot;order&quot;, order);&amp;#10;psychoJS.experiment.addData(&quot;Ans&quot;, NAMES[k]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="NAMES = ['UR', 'UL', 'BL', 'BR']&amp;#10;&amp;#10;thisExp.addData('quadA', quadA)&amp;#10;thisExp.addData('quadB', quadB)&amp;#10;thisExp.addData('quadC', quadC)&amp;#10;thisExp.addData('quadD', quadD)&amp;#10;thisExp.addData('order', order)&amp;#10;thisExp.addData('Ans',NAMES[k])" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="pattern" valType="code" updates="None" name="name"/>
      </CodeComponent>
