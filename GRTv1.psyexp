      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="print(f&quot;win size: {win.size}, aspect: {win.size[0]/win.size[1]:.3f}&quot;)&amp;#10;print(f&quot;x edge in height units: ±{win.size[0]/win.size[1]/2:.3f}&quot;)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="console.log(`win size: ${psychoJS.window.size}, aspect: ${util.pad(Number.parseFloat((psychoJS.window.size[0] / psychoJS.window.size[1])).toFixed(3), 1)}`);&amp;#10;console.log(`x edge in height units: ±${util.pad(Number.parseFloat(((psychoJS.window.size[0] / psychoJS.window.size[1]) / 2)).toFixed(3), 1)}`);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="cue_valid = rng.integers(2)&amp;#10;decide_pos = rng.integers(4)&amp;#10;&amp;#10;target_quad = decide_pos        # target 象限&amp;#10;pool = []&amp;#10;for q in range(4):&amp;#10;    if q != target_quad:&amp;#10;        pool.append(q)&amp;#10;&amp;#10;if cue_valid == 1:&amp;#10;    cue_idx = target_quad&amp;#10;else:&amp;#10;    cue_idx = pool[rng.integers(3)]&amp;#10;    &amp;#10;&amp;#10;cue_posx, cue_posy = POS[cue_idx]&amp;#10;target_posx, target_posy = POS[target_quad]&amp;#10;cue_color = itemColhex[target_quad]&amp;#10;cue_audi = itemAudi[target_quad]&amp;#10;POS_cue = POS[cue_idx]#cue_position&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;cue_valid&quot;, cue_valid);&amp;#10;psychoJS.experiment.addData(&quot;target_quad&quot;, target_quad);&amp;#10;psychoJS.experiment.addData(&quot;cue_idx&quot;, cue_idx);&amp;#10;psychoJS.experiment.addData(&quot;target_posx&quot;, cue_posx);&amp;#10;psychoJS.experiment.addData(&quot;target_posy&quot;, cue_posy);&amp;#10;psychoJS.experiment.addData(&quot;target_color&quot;, cue_color);&amp;#10;psychoJS.experiment.addData(&quot;target_audi&quot;, cue_audi);&amp;#10;psychoJS.experiment.addData(&quot;POS_cue&quot;, POS_cue);&amp;#10;psychoJS.experiment.addData(&quot;cue_valid&quot;, cue_valid);&amp;#10;psychoJS.experiment.addData(&quot;target_quad&quot;, target_quad);&amp;#10;psychoJS.experiment.addData(&quot;cue_idx&quot;, cue_idx);&amp;#10;psychoJS.experiment.addData(&quot;cue_posx&quot;, cue_posx);&amp;#10;psychoJS.experiment.addData(&quot;cue_posy&quot;, cue_posy);&amp;#10;psychoJS.experiment.addData(&quot;target_posx&quot;, target_posx);&amp;#10;psychoJS.experiment.addData(&quot;target_posy&quot;, target_posy);&amp;#10;psychoJS.experiment.addData(&quot;cue_color&quot;, cue_color);&amp;#10;psychoJS.experiment.addData(&quot;cue_audi&quot;, cue_audi);&amp;#10;psychoJS.experiment.addData(&quot;POS_cue&quot;, POS_cue);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('cue_valid', cue_valid)&amp;#10;thisExp.addData('target_quad', target_quad)&amp;#10;thisExp.addData('cue_idx', cue_idx)&amp;#10;thisExp.addData('target_posx', cue_posx)&amp;#10;thisExp.addData('target_posy', cue_posy)&amp;#10;thisExp.addData('target_color', cue_color)&amp;#10;thisExp.addData('target_audi', cue_audi)&amp;#10;thisExp.addData('POS_cue', POS_cue)&amp;#10;&amp;#10;thisExp.addData('cue_valid', cue_valid)&amp;#10;thisExp.addData('target_quad', target_quad)&amp;#10;thisExp.addData('cue_idx', cue_idx)&amp;#10;thisExp.addData('cue_posx', cue_posx)&amp;#10;thisExp.addData('cue_posy', cue_posy)&amp;#10;thisExp.addData('target_posx', target_posx)&amp;#10;thisExp.addData('target_posy', target_posy)&amp;#10;thisExp.addData('cue_color', cue_color)&amp;#10;thisExp.addData('cue_audi', cue_audi)&amp;#10;thisExp.addData('POS_cue', POS_cue)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
