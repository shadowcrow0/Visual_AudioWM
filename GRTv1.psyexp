      <CodeComponent name="recog" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="d = 10.0 / np.sqrt(2)&amp;#10;POS = [&amp;#10;    ( d,  d),&amp;#10;    (-d,  d),&amp;#10;    (-d, -d),&amp;#10;    ( d, -d),&amp;#10;]&amp;#10;GAP = 4.2&amp;#10;final_value = ['#B744A1', '#B52C95', '#B744A1', '#B52C95']&amp;#10;POS_TXT = []&amp;#10;POS_COL = []&amp;#10;for x, y in POS:&amp;#10;    POS_TXT.append((x, y + GAP/2))&amp;#10;    POS_COL.append((x, y - GAP/2))&amp;#10;&amp;#10;orders = rng.permutation(4)   # 畫面槽位重新洗牌&amp;#10;TXT = [&quot;[bε]&quot;,&quot;[bε]&quot;,&quot;[pε]&quot;,&quot;[pε]&quot;]&amp;#10;NAMES = ['UR', 'UL', 'BL', 'BR']&amp;#10;&amp;#10;txtUL_pos = POS_TXT[orders[0]]&amp;#10;colUL_pos = POS_COL[orders[0]]&amp;#10;UL_col = final_value[orders[0]]&amp;#10;UL_TXT = TXT[orders[0]]&amp;#10;UL_quad = NAMES[orders[0]]     # 這個槽位放的內容，代表哪個象限的item&amp;#10;&amp;#10;txtUR_pos = POS_TXT[orders[1]]&amp;#10;colUR_pos = POS_COL[orders[1]]&amp;#10;UR_col = final_value[orders[1]]&amp;#10;UR_TXT = TXT[orders[1]]&amp;#10;UR_quad = NAMES[orders[1]]&amp;#10;&amp;#10;txtBL_pos = POS_TXT[orders[2]]&amp;#10;colBL_pos = POS_COL[orders[2]]&amp;#10;BL_col = final_value[orders[2]]&amp;#10;BL_TXT = TXT[orders[2]]&amp;#10;BL_quad = NAMES[orders[2]]&amp;#10;&amp;#10;txtBR_pos = POS_TXT[orders[3]]&amp;#10;colBR_pos = POS_COL[orders[3]]&amp;#10;BR_col = final_value[orders[3]]&amp;#10;BR_TXT = TXT[orders[3]]&amp;#10;BR_quad = NAMES[orders[3]]" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;psychoJS.experiment.addData(&quot;txtBR_pos&quot;, txtBR_pos);&amp;#10;psychoJS.experiment.addData(&quot;colBR_pos&quot;, colBR_pos);&amp;#10;psychoJS.experiment.addData(&quot;BR_col&quot;, BR_col);&amp;#10;psychoJS.experiment.addData(&quot;BR_TXT&quot;, BR_TXT);&amp;#10;psychoJS.experiment.addData(&quot;txtBL_pos&quot;, txtBL_pos);&amp;#10;psychoJS.experiment.addData(&quot;colBL_pos&quot;, colBL_pos);&amp;#10;psychoJS.experiment.addData(&quot;BL_col&quot;, BL_col);&amp;#10;psychoJS.experiment.addData(&quot;BL_TXT&quot;, BL_TXT);&amp;#10;psychoJS.experiment.addData(&quot;txtUR_pos&quot;, txtUR_pos);&amp;#10;psychoJS.experiment.addData(&quot;colUR_pos&quot;, colUR_pos);&amp;#10;psychoJS.experiment.addData(&quot;UR_col&quot;, UR_col);&amp;#10;psychoJS.experiment.addData(&quot;UR_TXT&quot;, UR_TXT);&amp;#10;psychoJS.experiment.addData(&quot;txtUL_pos&quot;, txtUL_pos);&amp;#10;psychoJS.experiment.addData(&quot;colUL_pos&quot;, colUL_pos);&amp;#10;psychoJS.experiment.addData(&quot;UL_col&quot;, UL_col);&amp;#10;psychoJS.experiment.addData(&quot;UL_TXT&quot;, UL_TXT);&amp;#10;psychoJS.experiment.addData(&quot;UL_quad&quot;, UL_quad);&amp;#10;psychoJS.experiment.addData(&quot;UR_quad&quot;, UR_quad);&amp;#10;psychoJS.experiment.addData(&quot;BL_quad&quot;, BL_quad);&amp;#10;psychoJS.experiment.addData(&quot;BR_quad&quot;, BR_quad);&amp;#10;psychoJS.experiment.addData(&quot;task_orders&quot;, orders);&amp;#10;KEY_TO_QUAD_IDX = {&quot;f&quot;: 2, &quot;g&quot;: 1, &quot;h&quot;: 3, &quot;j&quot;: 0};&amp;#10;KEY_TO_SLOT = {&quot;f&quot;: &quot;BL&quot;, &quot;g&quot;: &quot;UL&quot;, &quot;h&quot;: &quot;BR&quot;, &quot;j&quot;: &quot;UR&quot;};&amp;#10;pressed_key = key_resp_2.keys;&amp;#10;if ((pressed_key instanceof Array)) {&amp;#10;    pressed_key = ((pressed_key.length &gt; 0) ? pressed_key.slice((- 1))[0] : null);&amp;#10;}&amp;#10;if (_pj.in_es6(pressed_key, KEY_TO_SLOT)) {&amp;#10;    chosen_slot = KEY_TO_SLOT[pressed_key];&amp;#10;    slot_quad_map = {&quot;UL&quot;: UL_quad, &quot;UR&quot;: UR_quad, &quot;BL&quot;: BL_quad, &quot;BR&quot;: BR_quad};&amp;#10;    chosen_quad_name = slot_quad_map[chosen_slot];&amp;#10;    correct_quad_name = NAMES[target_quad];&amp;#10;    is_correct = (chosen_quad_name === correct_quad_name);&amp;#10;} else {&amp;#10;    chosen_slot = null;&amp;#10;    chosen_quad_name = null;&amp;#10;    is_correct = false;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;pressed_key&quot;, pressed_key);&amp;#10;psychoJS.experiment.addData(&quot;chosen_slot&quot;, chosen_slot);&amp;#10;psychoJS.experiment.addData(&quot;chosen_quad_name&quot;, chosen_quad_name);&amp;#10;psychoJS.experiment.addData(&quot;correct_quad_name&quot;, correct_quad_name);&amp;#10;psychoJS.experiment.addData(&quot;is_correct&quot;, is_correct);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('txtBR_pos', txtBR_pos)&amp;#10;thisExp.addData('colBR_pos', colBR_pos)&amp;#10;thisExp.addData('BR_col', BR_col)&amp;#10;thisExp.addData('BR_TXT', BR_TXT)&amp;#10;&amp;#10;&amp;#10;thisExp.addData('txtBL_pos', txtBL_pos)&amp;#10;thisExp.addData('colBL_pos', colBL_pos)&amp;#10;thisExp.addData('BL_col', BL_col)&amp;#10;thisExp.addData('BL_TXT', BL_TXT)&amp;#10;&amp;#10;thisExp.addData('txtUR_pos', txtUR_pos)&amp;#10;thisExp.addData('colUR_pos', colUR_pos)&amp;#10;thisExp.addData('UR_col', UR_col)&amp;#10;thisExp.addData('UR_TXT', UR_TXT)&amp;#10;&amp;#10;thisExp.addData('txtUL_pos', txtUL_pos)&amp;#10;thisExp.addData('colUL_pos', colUL_pos)&amp;#10;thisExp.addData('UL_col', UL_col)&amp;#10;thisExp.addData('UL_TXT', UL_TXT)&amp;#10;&amp;#10;thisExp.addData('UL_quad', UL_quad)&amp;#10;thisExp.addData('UR_quad', UR_quad)&amp;#10;thisExp.addData('BL_quad', BL_quad)&amp;#10;thisExp.addData('BR_quad', BR_quad)&amp;#10;thisExp.addData('task_orders', orders)&amp;#10;KEY_TO_QUAD_IDX = {'f': 2, 'g': 1, 'h': 3, 'j': 0}&amp;#10;###之後更新RESPONAW BOX 的值&amp;#10;&amp;#10;KEY_TO_SLOT = {'f': 'BL', 'g': 'UL', 'h': 'BR', 'j': 'UR'}&amp;#10;&amp;#10;pressed_key = key_resp_2.keys   # 之後接Response Box時，改成從respond讀取&amp;#10;if isinstance(pressed_key, list):&amp;#10;    pressed_key = pressed_key[-1] if len(pressed_key) &gt; 0 else None&amp;#10;&amp;#10;if pressed_key in KEY_TO_SLOT:&amp;#10;    chosen_slot = KEY_TO_SLOT[pressed_key]          # 'UL'/'UR'/'BL'/'BR'&amp;#10;    slot_quad_map = {'UL': UL_quad, 'UR': UR_quad, 'BL': BL_quad, 'BR': BR_quad}&amp;#10;    chosen_quad_name = slot_quad_map[chosen_slot]   # 受試者選的位置，原本代表哪個象限(名稱字串,如'UR')&amp;#10;&amp;#10;    # target_quad是數字index(0~3)，NAMES是對照表，換成同樣的字串格式來比較&amp;#10;    correct_quad_name = NAMES[target_quad]&amp;#10;    is_correct = (chosen_quad_name == correct_quad_name)&amp;#10;else:&amp;#10;    chosen_slot = None&amp;#10;    chosen_quad_name = None&amp;#10;    is_correct = False&amp;#10;&amp;#10;thisExp.addData('pressed_key', pressed_key)&amp;#10;thisExp.addData('chosen_slot', chosen_slot)&amp;#10;thisExp.addData('chosen_quad_name', chosen_quad_name)&amp;#10;thisExp.addData('correct_quad_name', correct_quad_name)&amp;#10;thisExp.addData('is_correct', is_correct)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="recog" valType="code" updates="None" name="name"/>
      </CodeComponent>
