      </PolygonComponent>
      <KeyboardComponent name="adapt_key"><Param name="allowedKeys" val="'f','j'" valType="list" updates="None" /><Param name="correctAns" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="discard previous" val="True" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceEndRoutine" val="True" valType="bool" updates="None" /><Param name="name" val="adapt_key" valType="code" updates="None" /><Param name="registerOn" val="press" valType="str" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.5" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="store" val="last key" valType="str" updates="None" /><Param name="storeCorrect" val="False" valType="bool" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /></KeyboardComponent><SoundComponent name="adapt_col_sound" plugin="None">
