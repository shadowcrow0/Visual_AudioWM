  <Routine name="rest"><RoutineSettingsComponent name="rest"><Param name="backgroundFit" val="none" valType="str" updates="None" /><Param name="backgroundImg" val="" valType="str" updates="None" /><Param name="color" val="$[0,0,0]" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="desc" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceNonSlip" val="False" valType="code" updates="None" /><Param name="name" val="rest" valType="code" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="skipIf" val="" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="useWindowParams" val="False" valType="bool" updates="None" /></RoutineSettingsComponent><CodeComponent name="rest_code"><Param name="Before Experiment" val="" valType="extendedCode" updates="None" /><Param name="Before JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="Begin Experiment" val="" valType="extendedCode" updates="None" /><Param name="Begin JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="Begin Routine" val="# 這個 routine 只在三種時機顯示, 其餘試次直接跳過。&amp;#10;n_done = trial_i + 1&amp;#10;&amp;#10;if n_done == N_PRACTICE:&amp;#10;    pct = 100.0 * practice_correct / max(N_PRACTICE, 1)&amp;#10;    rest_msg = (&amp;#10;        &quot;Practice finished.\n\n&quot;&amp;#10;        f&quot;You got {practice_correct} of {N_PRACTICE} correct ({pct:.0f}%).\n\n&quot;&amp;#10;        &quot;If that felt like guessing, tell the experimenter now.\n\n&quot;&amp;#10;        &quot;The main experiment starts next. It is divided into &quot;&amp;#10;        f&quot;{n_blocks} blocks with a rest after each one.\n\n&quot;&amp;#10;        &quot;        g = upper left            j = upper right\n&quot;&amp;#10;        &quot;        f = lower left            h = lower right\n\n&quot;&amp;#10;        &quot;Press the space bar to begin.&quot;)&amp;#10;elif n_done &gt; N_PRACTICE and (n_done - N_PRACTICE) % BLOCK_SIZE == 0 and n_done &lt; N_TRIALS:&amp;#10;    done_blocks = (n_done - N_PRACTICE) // BLOCK_SIZE&amp;#10;    rest_msg = (&amp;#10;        f&quot;Block {done_blocks} of {n_blocks} finished.\n\n&quot;&amp;#10;        &quot;Take a rest. Look away from the screen for a moment.\n\n&quot;&amp;#10;        &quot;        g = upper left            j = upper right\n&quot;&amp;#10;        &quot;        f = lower left            h = lower right\n\n&quot;&amp;#10;        &quot;Press the space bar when you are ready to continue.&quot;)&amp;#10;else:&amp;#10;    continueRoutine = False&amp;#10;    rest_msg = &quot;&quot;&amp;#10;" valType="extendedCode" updates="None" /><Param name="Begin JS Routine" val="" valType="extendedCode" updates="None" /><Param name="Code Type" val="Py" valType="str" updates="None" /><Param name="Each Frame" val="" valType="extendedCode" updates="None" /><Param name="Each JS Frame" val="" valType="extendedCode" updates="None" /><Param name="End Experiment" val="" valType="extendedCode" updates="None" /><Param name="End JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="End Routine" val="" valType="extendedCode" updates="None" /><Param name="End JS Routine" val="" valType="extendedCode" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="name" val="rest_code" valType="code" updates="None" /></CodeComponent><TextComponent name="rest_text"><Param name="color" val="white" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="contrast" val="1" valType="num" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="draggable" val="False" valType="code" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="flip" val="None" valType="str" updates="None" /><Param name="font" val="Arial" valType="str" updates="None" /><Param name="languageStyle" val="LTR" valType="str" updates="None" /><Param name="letterHeight" val="0.8" valType="num" updates="None" /><Param name="name" val="rest_text" valType="code" updates="None" /><Param name="opacity" val="" valType="num" updates="None" /><Param name="ori" val="0" valType="num" updates="None" /><Param name="pos" val="(0, 0)" valType="list" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /><Param name="text" val="$rest_msg" valType="str" updates="set every repeat" /><Param name="units" val="from exp settings" valType="str" updates="None" /><Param name="validator" val="" valType="code" updates="None" /><Param name="wrapWidth" val="" valType="num" updates="None" /></TextComponent><KeyboardComponent name="rest_key"><Param name="allowedKeys" val="'space'" valType="list" updates="None" /><Param name="correctAns" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="discard previous" val="True" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceEndRoutine" val="True" valType="bool" updates="None" /><Param name="name" val="rest_key" valType="code" updates="None" /><Param name="registerOn" val="press" valType="str" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="store" val="nothing" valType="str" updates="None" /><Param name="storeCorrect" val="False" valType="bool" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /></KeyboardComponent></Routine><Routine name="instruction_adaptive"><RoutineSettingsComponent name="instruction_adaptive"><Param name="backgroundFit" val="none" valType="str" updates="None" /><Param name="backgroundImg" val="" valType="str" updates="None" /><Param name="color" val="$[0,0,0]" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="desc" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceNonSlip" val="False" valType="code" updates="None" /><Param name="name" val="instruction_adaptive" valType="code" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="skipIf" val="" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="useWindowParams" val="False" valType="bool" updates="None" /></RoutineSettingsComponent><TextComponent name="instruction_adaptive_text"><Param name="color" val="white" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="contrast" val="1" valType="num" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="draggable" val="False" valType="code" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="flip" val="None" valType="str" updates="None" /><Param name="font" val="Arial" valType="str" updates="None" /><Param name="languageStyle" val="LTR" valType="str" updates="None" /><Param name="letterHeight" val="0.8" valType="num" updates="None" /><Param name="name" val="instruction_adaptive_text" valType="code" updates="None" /><Param name="opacity" val="" valType="num" updates="None" /><Param name="ori" val="0" valType="num" updates="None" /><Param name="pos" val="(0, 0)" valType="list" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /><Param name="text" val="Colour calibration.&amp;#10;&amp;#10;You will see one coloured square at a time. Decide which&amp;#10;colour family it belongs to:&amp;#10;&amp;#10;        f = more blue            j = more pink&amp;#10;&amp;#10;A syllable plays with each square - it is always the same&amp;#10;one; you can ignore it.&amp;#10;&amp;#10;You get feedback after each answer. The colours are chosen&amp;#10;to stay difficult, so feeling unsure is normal - just answer&amp;#10;with your best guess every time.&amp;#10;&amp;#10;This short block (about 3-4 minutes) tunes the colours to&amp;#10;your eyes before the main experiment.&amp;#10;&amp;#10;Press the space bar to start." valType="str" updates="None" /><Param name="units" val="from exp settings" valType="str" updates="None" /><Param name="validator" val="" valType="code" updates="None" /><Param name="wrapWidth" val="" valType="num" updates="None" /></TextComponent><KeyboardComponent name="instruction_adaptive_key"><Param name="allowedKeys" val="'space'" valType="list" updates="None" /><Param name="correctAns" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="discard previous" val="True" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceEndRoutine" val="True" valType="bool" updates="None" /><Param name="name" val="instruction_adaptive_key" valType="code" updates="None" /><Param name="registerOn" val="press" valType="str" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="store" val="nothing" valType="str" updates="None" /><Param name="storeCorrect" val="False" valType="bool" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /></KeyboardComponent></Routine><Routine name="instruction_normal"><RoutineSettingsComponent name="instruction_normal"><Param name="backgroundFit" val="none" valType="str" updates="None" /><Param name="backgroundImg" val="" valType="str" updates="None" /><Param name="color" val="$[0,0,0]" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="desc" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceNonSlip" val="False" valType="code" updates="None" /><Param name="name" val="instruction_normal" valType="code" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="skipIf" val="" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="useWindowParams" val="False" valType="bool" updates="None" /></RoutineSettingsComponent><TextComponent name="instruction_normal_text"><Param name="color" val="white" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="contrast" val="1" valType="num" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="draggable" val="False" valType="code" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="flip" val="None" valType="str" updates="None" /><Param name="font" val="Arial" valType="str" updates="None" /><Param name="languageStyle" val="LTR" valType="str" updates="None" /><Param name="letterHeight" val="0.8" valType="num" updates="None" /><Param name="name" val="instruction_normal_text" valType="code" updates="None" /><Param name="opacity" val="" valType="num" updates="None" /><Param name="ori" val="0" valType="num" updates="None" /><Param name="pos" val="(0, 0)" valType="list" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /><Param name="text" val="Main experiment.&amp;#10;&amp;#10;You will see four coloured squares. They appear one at a time,&amp;#10;in the four corners of the screen. Each square is paired with a&amp;#10;speech sound. Try to remember which colour and which sound went&amp;#10;together, and where each one appeared.&amp;#10;&amp;#10;A marker will then point to one of the corners.&amp;#10;Your task is to report which item was there.&amp;#10;&amp;#10;Four options will be shown, one in each corner.&amp;#10;Press the key matching the position of your choice:&amp;#10;&amp;#10;        g = upper left            j = upper right&amp;#10;        f = lower left            h = lower right&amp;#10;&amp;#10;You will start with a short practice, then the experiment proper&amp;#10;in four blocks with a rest after each one.&amp;#10;&amp;#10;Answer as accurately as you can. Speed is not important.&amp;#10;&amp;#10;Press the space bar to begin." valType="str" updates="None" /><Param name="units" val="from exp settings" valType="str" updates="None" /><Param name="validator" val="" valType="code" updates="None" /><Param name="wrapWidth" val="" valType="num" updates="None" /></TextComponent><KeyboardComponent name="instruction_normal_key"><Param name="allowedKeys" val="'space'" valType="list" updates="None" /><Param name="correctAns" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="discard previous" val="True" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceEndRoutine" val="True" valType="bool" updates="None" /><Param name="name" val="instruction_normal_key" valType="code" updates="None" /><Param name="registerOn" val="press" valType="str" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="store" val="nothing" valType="str" updates="None" /><Param name="storeCorrect" val="False" valType="bool" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /></KeyboardComponent></Routine><Routine name="adaptive_col"><RoutineSettingsComponent name="adaptive_col"><Param name="backgroundFit" val="none" valType="str" updates="None" /><Param name="backgroundImg" val="" valType="str" updates="None" /><Param name="color" val="$[0,0,0]" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="desc" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceNonSlip" val="False" valType="code" updates="None" /><Param name="name" val="adaptive_col" valType="code" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="skipIf" val="" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="useWindowParams" val="False" valType="bool" updates="None" /></RoutineSettingsComponent><CodeComponent name="adapt_code"><Param name="Before Experiment" val="" valType="extendedCode" updates="None" /><Param name="Before JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="Begin Experiment" val="# ── 顏色 adaptive 校準 (Psi; Kontsevich &amp; Tyler 1999, AGRT 實作) ──&amp;#10;# 聲音維度固定在 beachpeach 端點, 不做 adaptive; staircase 只跑顏色。&amp;#10;from AGRT import agrtPsiObject&amp;#10;import agrt_setup as _AS&amp;#10;&amp;#10;N_ADAPT     = 60      # staircase 試次數 (~3-4 分鐘)&amp;#10;OVERALL_ACC = 0.64    # 每維目標正確率 = sqrt(0.64) = 0.80&amp;#10;                      # &lt;- 待確認的旋鈕: 若要知覺更乾淨, 0.81 -&gt; 每維 0.90&amp;#10;PSI_DELTA   = 0.08    # lapse; 與 beta 上限除數 2.3107 的推導一致&amp;#10;KEY_LO, KEY_HI = 'f', 'j'   # f = 偏藍側(arc&lt;0), j = 偏粉側(arc&gt;0)&amp;#10;&amp;#10;_glo, _ghi = _AS.arc_range_in_gamut()&amp;#10;ARC_LIM  = min(-_glo, _ghi)            # 對稱可用半長 ~24.14 dE00&amp;#10;BETA_MAX = _AS.max_supportable_sd()    # ~10.45 dE00&amp;#10;&amp;#10;psi = agrtPsiObject(x=(-ARC_LIM, ARC_LIM), alpha=(-8.0, 8.0),&amp;#10;                    beta=(0.25, BETA_MAX), xPrecision=201,&amp;#10;                    aPrecision=81, bPrecision=81,&amp;#10;                    delta=PSI_DELTA, stepType='lin')&amp;#10;psi.update(None)      # 初始化, 產生第一個提議值&amp;#10;adapt_i = 0&amp;#10;" valType="extendedCode" updates="None" /><Param name="Begin JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="Begin Routine" val="adapt_arc   = float(psi.nextIntensity)&amp;#10;adapt_hex   = colour_for(adapt_arc)&amp;#10;adapt_truth = 1 if adapt_arc &gt; 0 else 0   # 邊界 = 錨點 303 度 (arc = 0)&amp;#10;" valType="extendedCode" updates="None" /><Param name="Begin JS Routine" val="" valType="extendedCode" updates="None" /><Param name="Code Type" val="Py" valType="str" updates="None" /><Param name="Each Frame" val="" valType="extendedCode" updates="None" /><Param name="Each JS Frame" val="" valType="extendedCode" updates="None" /><Param name="End Experiment" val="" valType="extendedCode" updates="None" /><Param name="End JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="End Routine" val="_k = adapt_key.keys&amp;#10;adapt_resp    = 1 if _k == KEY_HI else 0&amp;#10;adapt_correct = int(adapt_resp == adapt_truth)&amp;#10;psi.update(adapt_resp)&amp;#10;adapt_i += 1&amp;#10;fb_msg = 'Correct' if adapt_correct else 'Wrong'&amp;#10;&amp;#10;thisExp.addData('adapt_i', adapt_i)&amp;#10;thisExp.addData('adapt_arc', adapt_arc)&amp;#10;thisExp.addData('adapt_hex', adapt_hex)&amp;#10;thisExp.addData('adapt_resp', adapt_resp)&amp;#10;thisExp.addData('adapt_correct', adapt_correct)&amp;#10;&amp;#10;if adapt_i &gt;= N_ADAPT:&amp;#10;    _a, _b = psi.estimateLambda()&amp;#10;    _lo_x, _hi_x = psi.estimateThreshold(OVERALL_ACC, None)&amp;#10;    # 防禦性夾值(數學上 |alpha|+0.95*beta &lt; ARC_LIM, 不應觸發)&amp;#10;    _lo_x = max(float(_lo_x), -ARC_LIM)&amp;#10;    _hi_x = min(float(_hi_x),  ARC_LIM)&amp;#10;    COLOUR_ARC = [_lo_x, _hi_x]          # 覆寫全域 -&gt; study/pattern 每 trial 重讀&amp;#10;    COLOUR_HEX = [colour_for(_lo_x), colour_for(_hi_x)]&amp;#10;    thisExp.addData('psi_alpha', float(_a))&amp;#10;    thisExp.addData('psi_beta', float(_b))&amp;#10;    thisExp.addData('colour_arc_lo', _lo_x)&amp;#10;    thisExp.addData('colour_arc_hi', _hi_x)&amp;#10;    thisExp.addData('colour_hex_lo', COLOUR_HEX[0])&amp;#10;    thisExp.addData('colour_hex_hi', COLOUR_HEX[1])&amp;#10;    print(f&quot;[adaptive] alpha={_a:.2f} beta={_b:.2f} -&gt; {COLOUR_ARC} -&gt; {COLOUR_HEX}&quot;)&amp;#10;" valType="extendedCode" updates="None" /><Param name="End JS Routine" val="" valType="extendedCode" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="name" val="adapt_code" valType="code" updates="None" /></CodeComponent><PolygonComponent name="adapt_patch" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="hex" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
