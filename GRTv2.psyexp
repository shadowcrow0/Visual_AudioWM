      </Routine><Routine name="adapt_fb"><RoutineSettingsComponent name="adapt_fb"><Param name="backgroundFit" val="none" valType="str" updates="None" /><Param name="backgroundImg" val="" valType="str" updates="None" /><Param name="color" val="$[0,0,0]" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="desc" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceNonSlip" val="False" valType="code" updates="None" /><Param name="name" val="adapt_fb" valType="code" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="skipIf" val="" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="useWindowParams" val="False" valType="bool" updates="None" /></RoutineSettingsComponent><TextComponent name="fb_text"><Param name="color" val="white" valType="color" updates="constant" /><Param name="colorSpace" val="rgb" valType="str" updates="constant" /><Param name="contrast" val="1" valType="num" updates="constant" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="draggable" val="False" valType="code" updates="constant" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="flip" val="None" valType="str" updates="constant" /><Param name="font" val="Arial" valType="str" updates="constant" /><Param name="languageStyle" val="LTR" valType="str" updates="constant" /><Param name="letterHeight" val="1.2" valType="num" updates="constant" /><Param name="name" val="fb_text" valType="code" updates="None" /><Param name="opacity" val="" valType="num" updates="constant" /><Param name="ori" val="0" valType="num" updates="constant" /><Param name="pos" val="(0, 0)" valType="list" updates="constant" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="0.6" valType="code" updates="constant" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /><Param name="text" val="$fb_msg" valType="str" updates="set every repeat" /><Param name="units" val="from exp settings" valType="str" updates="None" /><Param name="validator" val="" valType="code" updates="None" /><Param name="wrapWidth" val="" valType="num" updates="constant" /></TextComponent></Routine><Routine name="adaptive_snd"><RoutineSettingsComponent name="adaptive_snd"><Param name="backgroundFit" val="none" valType="str" updates="None" /><Param name="backgroundImg" val="" valType="str" updates="None" /><Param name="color" val="$[0,0,0]" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="desc" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceNonSlip" val="False" valType="code" updates="None" /><Param name="name" val="adaptive_snd" valType="code" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="skipIf" val="" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="useWindowParams" val="False" valType="bool" updates="None" /></RoutineSettingsComponent><CodeComponent name="adapt_snd_code"><Param name="Before Experiment" val="" valType="extendedCode" updates="None" /><Param name="Before JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="Begin Experiment" val="# ── 聲音 adaptive 校準 (Psi;與顏色分開的獨立 staircase) ──&amp;#10;# 座標 = beachpeach 連續體步階 1..9(離散格點)。做聲音時顏色恆定(錨點色)。&amp;#10;# 端點是 fallback:斜率太淺時放置點被夾回 1/9,自然退回端點設計。&amp;#10;from AGRT import agrtPsiObject&amp;#10;&amp;#10;N_ADAPT_SND     = 45&amp;#10;OVERALL_ACC_SND = 0.64    # 每維 sqrt(0.64)=0.80;要改與顏色的 OVERALL_ACC 一起改&amp;#10;SND_DELTA       = 0.08&amp;#10;KEY_B, KEY_P    = 'f', 'j'&amp;#10;SND_FILES = ['stimuli/kutlu_mcmurray_2024/cv/beachpeach%d_cv.wav' % _i&amp;#10;             for _i in range(1, 10)]&amp;#10;&amp;#10;psi_snd = agrtPsiObject(x=(1.0, 9.0), alpha=(1.5, 8.5), beta=(0.2, 3.46),&amp;#10;                        xPrecision=9, aPrecision=81, bPrecision=81,&amp;#10;                        delta=SND_DELTA, stepType='lin')&amp;#10;psi_snd.update(None)&amp;#10;adapt_snd_i = 0&amp;#10;" valType="extendedCode" updates="None" /><Param name="Begin JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="Begin Routine" val="adapt_snd_step = int(round(float(psi_snd.nextIntensity)))&amp;#10;adapt_snd_file = SND_FILES[adapt_snd_step - 1]&amp;#10;adapt_snd_hex  = colour_for(0.0)      # 顏色恆定 = 錨點 (303 度, arc=0)&amp;#10;" valType="extendedCode" updates="None" /><Param name="Begin JS Routine" val="" valType="extendedCode" updates="None" /><Param name="Code Type" val="Py" valType="str" updates="None" /><Param name="Each Frame" val="" valType="extendedCode" updates="None" /><Param name="Each JS Frame" val="" valType="extendedCode" updates="None" /><Param name="End Experiment" val="" valType="extendedCode" updates="None" /><Param name="End JS Experiment" val="" valType="extendedCode" updates="None" /><Param name="End Routine" val="_k = adapt_snd_key.keys&amp;#10;adapt_snd_resp = 1 if _k == KEY_P else 0&amp;#10;psi_snd.update(adapt_snd_resp)&amp;#10;adapt_snd_i += 1&amp;#10;&amp;#10;if adapt_snd_step == 5:&amp;#10;    adapt_snd_correct = -1        # 連續體中點沒有正解, 不給對錯回饋&amp;#10;    fb_msg = ''&amp;#10;else:&amp;#10;    _truth = 1 if adapt_snd_step &gt; 5 else 0&amp;#10;    adapt_snd_correct = int(adapt_snd_resp == _truth)&amp;#10;    fb_msg = 'Correct' if adapt_snd_correct else 'Wrong'&amp;#10;&amp;#10;thisExp.addData('adapt_snd_i', adapt_snd_i)&amp;#10;thisExp.addData('adapt_snd_step', adapt_snd_step)&amp;#10;thisExp.addData('adapt_snd_resp', adapt_snd_resp)&amp;#10;thisExp.addData('adapt_snd_correct', adapt_snd_correct)&amp;#10;&amp;#10;if adapt_snd_i &gt;= N_ADAPT_SND:&amp;#10;    _a, _b = psi_snd.estimateLambda()&amp;#10;    _lo, _hi = psi_snd.estimateThreshold(OVERALL_ACC_SND, None)&amp;#10;    _s1 = int(round(min(max(float(_lo), 1.0), 9.0)))&amp;#10;    _s2 = int(round(min(max(float(_hi), 1.0), 9.0)))&amp;#10;    if _s1 == _s2:                # 斜率極陡, 兩點落同一步 -&gt; 拉開成相鄰步&amp;#10;        if _s2 &lt; 9:&amp;#10;            _s2 += 1&amp;#10;        else:&amp;#10;            _s1 -= 1&amp;#10;    AUDIO_B = SND_FILES[_s1 - 1]  # 覆寫全域 -&gt; study/pattern 每 trial 重讀&amp;#10;    AUDIO_P = SND_FILES[_s2 - 1]&amp;#10;    thisExp.addData('psi_snd_alpha', float(_a))&amp;#10;    thisExp.addData('psi_snd_beta', float(_b))&amp;#10;    thisExp.addData('snd_step_b', _s1)&amp;#10;    thisExp.addData('snd_step_p', _s2)&amp;#10;    print(f&quot;[adaptive-snd] alpha={_a:.2f} beta={_b:.2f} -&gt; steps {_s1}/{_s2}&quot;)&amp;#10;" valType="extendedCode" updates="None" /><Param name="End JS Routine" val="" valType="extendedCode" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="name" val="adapt_snd_code" valType="code" updates="None" /></CodeComponent><PolygonComponent name="adapt_snd_patch" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="hex" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="$adapt_snd_hex" valType="color" updates="set every repeat" name="fillColor" />
        <Param val="linear" valType="str" updates="constant" name="interpolate" />
        <Param val="" valType="color" updates="constant" name="lineColor" />
        <Param val="1" valType="num" updates="constant" name="lineWidth" />
        <Param val="4" valType="int" updates="constant" name="nVertices" />
        <Param val="adapt_snd_patch" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="rectangle" valType="str" updates="None" name="shape" />
        <Param val="(4, 4)" valType="list" updates="constant" name="size" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.5" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="1.0" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="from exp settings" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="" valType="list" updates="constant" name="vertices" />
      </PolygonComponent>
      <SoundComponent name="adapt_snd_sound" plugin="None">
        <Param val="Laptop" valType="device" updates="None" name="deviceLabel" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="bool" updates="constant" name="forceEndRoutine" />
        <Param val="True" valType="bool" updates="constant" name="hamming" />
        <Param val="adapt_snd_sound" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="$adapt_snd_file" valType="str" updates="set every repeat" name="sound" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.5" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="1.0" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="constant" name="stopWithRoutine" />
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="1" valType="num" updates="constant" name="volume" />
      </SoundComponent>
      <KeyboardComponent name="adapt_snd_key"><Param name="allowedKeys" val="'f','j'" valType="list" updates="None" /><Param name="correctAns" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="discard previous" val="True" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceEndRoutine" val="True" valType="bool" updates="None" /><Param name="name" val="adapt_snd_key" valType="code" updates="None" /><Param name="registerOn" val="press" valType="str" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.5" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="store" val="last key" valType="str" updates="None" /><Param name="storeCorrect" val="False" valType="bool" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /></KeyboardComponent></Routine><Routine name="instruction_adaptive_snd"><RoutineSettingsComponent name="instruction_adaptive_snd"><Param name="backgroundFit" val="none" valType="str" updates="None" /><Param name="backgroundImg" val="" valType="str" updates="None" /><Param name="color" val="$[0,0,0]" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="desc" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceNonSlip" val="False" valType="code" updates="None" /><Param name="name" val="instruction_adaptive_snd" valType="code" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="skipIf" val="" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="useWindowParams" val="False" valType="bool" updates="None" /></RoutineSettingsComponent><TextComponent name="instruction_adaptive_snd_text"><Param name="color" val="white" valType="color" updates="None" /><Param name="colorSpace" val="rgb" valType="str" updates="None" /><Param name="contrast" val="1" valType="num" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="draggable" val="False" valType="code" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="flip" val="None" valType="str" updates="None" /><Param name="font" val="Arial" valType="str" updates="None" /><Param name="languageStyle" val="LTR" valType="str" updates="None" /><Param name="letterHeight" val="0.8" valType="num" updates="None" /><Param name="name" val="instruction_adaptive_snd_text" valType="code" updates="None" /><Param name="opacity" val="" valType="num" updates="None" /><Param name="ori" val="0" valType="num" updates="None" /><Param name="pos" val="(0, 0)" valType="list" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /><Param name="text" val="Sound calibration.&amp;#10;&amp;#10;You will hear one syllable at a time. Decide which consonant&amp;#10;it starts with:&amp;#10;&amp;#10;        f = sounds like 'b'            j = sounds like 'p'&amp;#10;&amp;#10;A coloured square appears with each sound - it is always the&amp;#10;same colour; you can ignore it.&amp;#10;&amp;#10;You get feedback after most answers. The sounds are chosen to&amp;#10;stay difficult, so feeling unsure is normal - just answer with&amp;#10;your best guess every time.&amp;#10;&amp;#10;This short block (about 2-3 minutes) tunes the sounds to your&amp;#10;ears before the main experiment.&amp;#10;&amp;#10;Press the space bar to start." valType="str" updates="None" /><Param name="units" val="from exp settings" valType="str" updates="None" /><Param name="validator" val="" valType="code" updates="None" /><Param name="wrapWidth" val="" valType="num" updates="None" /></TextComponent><KeyboardComponent name="instruction_adaptive_snd_key"><Param name="allowedKeys" val="'space'" valType="list" updates="None" /><Param name="correctAns" val="" valType="str" updates="None" /><Param name="disabled" val="False" valType="bool" updates="None" /><Param name="discard previous" val="True" valType="bool" updates="None" /><Param name="durationEstim" val="" valType="code" updates="None" /><Param name="forceEndRoutine" val="True" valType="bool" updates="None" /><Param name="name" val="instruction_adaptive_snd_key" valType="code" updates="None" /><Param name="registerOn" val="press" valType="str" updates="None" /><Param name="saveStartStop" val="True" valType="bool" updates="None" /><Param name="startEstim" val="" valType="code" updates="None" /><Param name="startType" val="time (s)" valType="str" updates="None" /><Param name="startVal" val="0.0" valType="code" updates="None" /><Param name="stopType" val="duration (s)" valType="str" updates="None" /><Param name="stopVal" val="" valType="code" updates="None" /><Param name="store" val="nothing" valType="str" updates="None" /><Param name="storeCorrect" val="False" valType="bool" updates="None" /><Param name="syncScreenRefresh" val="True" valType="bool" updates="None" /></KeyboardComponent></Routine></Routines>
  <Flow>
    <Routine name="Intro" />
    <Routine name="instruction_normal" /><LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str" />
      <Param name="conditions" updates="None" val="None" valType="str" />
      <Param name="conditionsFile" updates="None" val="" valType="file" />
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code" />
      <Param name="isTrials" updates="None" val="False" valType="bool" />
      <Param name="loopType" updates="None" val="random" valType="str" />
      <Param name="nReps" updates="None" val="N_TRIALS" valType="code" />
      <Param name="name" updates="None" val="trials" valType="code" />
      <Param name="random seed" updates="None" val="" valType="code" />
    </LoopInitiator>
    <Routine name="study" />
    <Routine name="cue" />
    <Routine name="task" />
    <Routine name="rest" /><LoopTerminator name="trials" />
  </Flow>
</PsychoPy2experiment>