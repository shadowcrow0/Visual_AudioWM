      <CodeComponent name="check_screen" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="from psychopy import monitors&amp;#10;m = win.monitor&amp;#10;print(f&quot;monitor: {m.name}&quot;)&amp;#10;print(f&quot;width_cm: {m.getWidth()}, dist_cm: {m.getDistance()}&quot;)&amp;#10;print(f&quot;res: {m.getSizePix()}, win: {win.size}&quot;)" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="import {monitors} from 'psychopy';&amp;#10;m = psychoJS.window.monitor;&amp;#10;console.log(`monitor: ${m.name}`);&amp;#10;console.log(`width_cm: ${m.getWidth()}, dist_cm: ${m.getDistance()}`);&amp;#10;console.log(`res: ${m.getSizePix()}, win: ${psychoJS.window.size}`);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
