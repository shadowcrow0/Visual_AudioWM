        <Param val="if PHASE in ('practice', 'main'):                        # 校準時 targetCol / targetAud 已在 study_stage 決定&amp;#10;    condition = probe_plan.pop(0)&amp;#10;    cond_name, col_key, snd_key = COND[condition]&amp;#10;    targetCol, targetAud = st[col_key], st[snd_key]&amp;#10;    is_match = (cond_name == 'AA')" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
